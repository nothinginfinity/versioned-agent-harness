{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory.schema.json",
  "title": "Memory",
  "description": "Durable compressed state for a harnessed LLM agent or project",
  "type": "object",
  "required": ["schema_version", "generated_at", "project"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": { "type": "string" },
    "current_phase": { "type": "string" },
    "last_spec_number": { "type": "string" },
    "decisions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
