{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness.schema.json",
  "title": "Harness",
  "description": "Metadata for a version-controlled LLM agent harness",
  "type": "object",
  "required": ["id", "version", "mode", "status", "agent_role"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["read-only", "draft-only", "write-capable", "admin"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "agent_role": { "type": "string" },
    "startup_reads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "memory_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "communication_surfaces": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
