{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill.schema.json",
  "title": "Skill",
  "description": "Metadata for a lazy-loaded LLM skill",
  "type": "object",
  "required": ["id", "version", "status", "trigger_conditions"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "trigger_conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_format": { "type": "string" },
    "quality_checks": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
